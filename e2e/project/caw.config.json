{
    "language": "de",
    "framework": "extjs",
    "start": "/app",
    "agent": {
        "mode": "docker"
    },
    "environments": {
        "dev": {
            "url": "https://portal.localhost:8453",
            "claude": true,
            "writable": true,
            "insecureTls": true
        }
    },
    "signIn": {
        "type": "form",
        "path": "/signin",
        "userSelector": "#login_login",
        "passwordSelector": "#login_password",
        "signedInSelector": "body.signed-in"
    },
    "consoleIgnore": [
        "AppConstants",
        "Cannot read",
        "is not a function",
        "is not defined",
        "undefined",
        "favicon"
    ],
    "overlay": {
        "environments": [
            "dev"
        ],
        "assetUrlPattern": "DataProxy(?:\\.|[^#]*?[?&])url=repo:/{3}Root/([^&#]*)",
        "parts": {
            "bestellung": {
                "dir": ".",
                "statics": [
                    {
                        "name": "Fx/Static.js",
                        "path": "static.js"
                    }
                ]
            }
        }
    },
    "roles": {
        "kunde": {}
    },
    "requestKeys": [
        "connector"
    ]
}
