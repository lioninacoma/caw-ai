# GENERATED by caw-ai from the project's image or the default image. Do not edit by hand.
FROM {{image}}

USER root

# The project's image usually has the user already; otherwise it is created.
RUN id -u {{user}} >/dev/null 2>&1 || useradd --create-home --shell /bin/bash {{user}}

# Firewall tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends iptables \
    && update-alternatives --set iptables /usr/sbin/iptables-legacy \
    && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy \
    && command -v setpriv \
    && rm -rf /var/lib/apt/lists/*

# Claude Code, pinned to the major version caw-ai is tested with.
RUN npm install -g --no-audit --no-fund @anthropic-ai/claude-code@2

# The container part of the tool uses only Node built-ins; the browser runs on the host.
COPY tool /opt/caw-ai
RUN printf '#!/bin/sh\nexec node /opt/caw-ai/bin/caw-ai.mjs "$@"\n' > /usr/local/bin/caw-ai \
    && chmod 0755 /usr/local/bin/caw-ai

COPY skill.md /home/{{user}}/.claude/skills/caw-ai/SKILL.md
RUN chown -R {{user}}: /home/{{user}}/.claude

COPY init-firewall.sh /usr/local/bin/caw-init-firewall
COPY entrypoint.sh /usr/local/bin/caw-entrypoint
RUN chmod 0755 /usr/local/bin/caw-init-firewall /usr/local/bin/caw-entrypoint

ENV CAW_SANDBOX=1
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Starts as root, only for the firewall. The entrypoint then switches the user for good.
USER root
ENTRYPOINT ["/usr/local/bin/caw-entrypoint"]
