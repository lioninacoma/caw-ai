        runTag,
        text,
        regex,
        waitReady,
        settle,
        /** A click on something that does not come every time (a cookie banner): skipped if it is not there within 3 s. */
        optional: async (locator) => {
            const there = await locator.waitFor({ state: 'visible', timeout: OPTIONAL_MS }).then(() => true, () => false);
