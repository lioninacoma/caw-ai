                await page.locator(how.passwordSelector).fill(user.password);
                if (how.codeSelector) await page.locator(how.codeSelector).fill(totp(user.totp));
                if (how.submitSelector) await page.locator(how.submitSelector).click();
                else await page.locator(how.codeSelector ?? how.passwordSelector).press('Enter');
            }
