// Self-contained: only @playwright/test. Sign-in, waiting for a quiet page, placeholders ({{runTag}}, dates, remembered values),
// dialogs, uploads and downloads as caw replays them. Test users come from the environment, like caw's: CAW_<ROLE>_USER,
// CAW_<ROLE>_PASSWORD, CAW_<ROLE>_TOTP, optionally with __<ENV>; CAW_BASE_URL overrides the address.
import { createHmac } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

import { expect, selectors } from '@playwright/test';

const CAW = /* caw:settings */ {};
/** Runs in the page: what is still loading, as caw's adapter for this framework sees it. */
const PROBE = /* caw:probe */ null;
/** The selector engine extjs= (Ext.ComponentQuery), when the app is an ExtJS app. */
const EXTJS_ENGINE = /* caw:extjs */ null;

if (EXTJS_ENGINE !== null) {
    try {
        await selectors.register('extjs', { content: EXTJS_ENGINE });
    } catch (error) {
        if (!/already registered/.test(error?.message ?? '')) throw error;
    }
