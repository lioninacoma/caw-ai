                    } else if (step.click !== undefined) await page.locator(step.click).click({ timeout });
                    else if (step.waitFor !== undefined) await page.locator(step.waitFor).waitFor({ state: 'visible', timeout });
                    else if (step.on !== undefined) await page.locator(step.on).press(step.press, { timeout });
                    else await page.keyboard.press(step.press);
