    };
    /** After an action that may change the page: loaded and quiet, as caw settles; never fails on its own. */
    const settle = async () => {
        await page.waitForLoadState('load').catch(() => {});
        await waitReady({ soft: true });
    };

    const signIn = async () => {
        const how = CAW.signIn;
        if (how.type === 'none' || how.type === 'basic') return;
        await page.goto(how.path ?? '/');
        if (how.type === 'form') {
            const user = account(role);
            if (Array.isArray(how.steps)) {
                for (const step of how.steps) {
                    const timeout = step.timeoutMs ?? SIGN_IN_TIMEOUT_MS;
                    const target = step.fill ?? step.click ?? step.waitFor ?? step.on;
                    if (step.optional === true && target !== undefined) {
                        const there = await page.locator(target).first().waitFor({ state: 'visible', timeout: OPTIONAL_MS }).then(() => true, () => false);
                        if (!there) continue;
