const SIGN_IN_TIMEOUT_MS = 30_000;
const OPTIONAL_MS = 3_000;
const READY = { timeout: 15_000, quietMs: 250, pollMs: 100 };

/** The address of the environment; CAW_BASE_URL overrides it. */
export const baseURL = () => process.env.CAW_BASE_URL || CAW.url;

/** Playwright options for the context: Basic credentials (gate or sign-in) or a saved session. */
export const contextOptions = (role) => {
    const options = { ignoreHTTPSErrors: CAW.insecureTls === true };
    const basic = CAW.gate ? account('gate') : CAW.signIn.type === 'basic' ? account(role) : null;
    if (basic !== null) options.httpCredentials = { username: basic.user, password: basic.password, origin: new URL(baseURL()).origin };
    if (CAW.signIn.type === 'session') options.storageState = fileURLToPath(new URL(CAW.sessions[role], import.meta.url));
    return options;
};

/** A test user from the environment: the set for this environment, else the default set, never mixed. */
const account = (who) => {
    const names = CAW.accounts[who];
    const pick = (set) => ({ user: process.env[set.user], password: process.env[set.password], totp: process.env[set.totp] });
    const own = names.env === undefined ? {} : pick(names.env);
    const chosen = own.user || own.password ? own : pick(names.default);
    if (!chosen.user || !chosen.password) throw new Error(`Set ${names.default.user} and ${names.default.password} (or ${names.env?.user ?? ''} …) for ${who}.`);
    return chosen;
};

/** RFC 6238: HMAC-SHA1, 30 s, 6 digits, Base32 secret, as authenticator apps show it. */
const totp = (secret, now = Date.now()) => {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
    let bits = '';
    for (const char of String(secret).toUpperCase().replace(/[\s=-]/g, '')) bits += alphabet.indexOf(char).toString(2).padStart(5, '0');
    const key = Buffer.from((bits.match(/.{8}/g) ?? []).map((byte) => parseInt(byte, 2)));
    const counter = Buffer.alloc(8);
    counter.writeBigUInt64BE(BigInt(Math.floor(now / 30_000)));
    const mac = createHmac('sha1', key).update(counter).digest();
    const offset = mac[mac.length - 1] & 0x0f;
    return String((mac.readUInt32BE(offset) & 0x7fffffff) % 1_000_000).padStart(6, '0');
};

/** CAW-<yyyyMMddHHmmssSSS><2 digits>, like caw's run tag: unique per run, so records of earlier runs do not interfere. */
const newRunTag = () => `CAW-${new Date().toISOString().replace(/[^0-9]/g, '').slice(0, 17)}${String(Math.floor(Math.random() * 100)).padStart(2, '0')}`;

/** A value inside a string literal of code (O'Brien), as caw does for checks and remember code. */
const codeText = (value) => value.replace(/[\\'"`$]/g, '\\$&').replaceAll('\n', '\\n').replaceAll('\r', '\\r');
const regexText = (value) => value.replace(/[.*+?^${}()|[\]\\/]/g, '\\$&');

/** Today in the recording's time zone, shifted by days. */
const day = (offset) => {
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: CAW.timezone, year: 'numeric', month: 'numeric', day: 'numeric' })
        .formatToParts(new Date()).filter(({ type }) => type !== 'literal').map(({ type, value }) => [type, Number(value)]));
    return new Date(parts.year, parts.month - 1, parts.day + offset);
};
const pad = (number) => String(number).padStart(2, '0');
const isoOf = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
/** {{date}} in the locale's numeric format (day, month, year in its order with its separators), ISO where it has none. */
const localDate = (date) => {
    const parts = new Intl.DateTimeFormat(CAW.locale, { year: 'numeric', month: '2-digit', day: '2-digit', numberingSystem: 'latn' }).formatToParts(date)
        .filter(({ type }) => ['day', 'month', 'year', 'literal'].includes(type));
    const fields = parts.filter(({ type }) => type !== 'literal');
    if (fields.length !== 3 || parts.length !== 5 || parts[0].type === 'literal') return isoOf(date);
    return parts.map(({ type, value }) => (type === 'day' ? pad(date.getDate()) : type === 'month' ? pad(date.getMonth() + 1) : type === 'year' ? String(date.getFullYear()) : value)).join('');
};

/**
 * Everything one test run needs: sign-in, placeholders, waiting, checks. Call it at the start of the test.
 * @returns the helpers the generated spec uses
 */
export const start = async (page, { role, path }) => {
    const runTag = newRunTag();
    const remembered = new Map();
    // Open requests as caw counts them: XHR and fetch to the app's host; a stream (server-sent events, NDJSON) never, a request
    // whose headers arrived only for 1.5 s more, and nothing open longer than 10 s (long polling).
    const appHost = new URL(baseURL()).hostname;
    const open = new Map();
    page.on('request', (request) => {
        let host = '';
        try {
            host = new URL(request.url()).hostname;
        } catch {
            return;
        }
        if (['xhr', 'fetch'].includes(request.resourceType()) && host === appHost) open.set(request, { start: Date.now() });
    });
    page.on('response', (response) => {
        const entry = open.get(response.request());
        if (entry === undefined) return;
        if (/text\/event-stream|application\/(x-)?ndjson|application\/stream\+json|application\/jsonl/i.test(response.headers()['content-type'] ?? '')) entry.stream = true;
        else entry.answeredAt = Date.now();
    });
    const done = (request) => { open.delete(request); };
    page.on('requestfinished', done);
    page.on('requestfailed', done);
    const pending = () => {
        const now = Date.now();
        return [...open.values()].filter((entry) => entry.stream !== true && (entry.answeredAt === undefined || now - entry.answeredAt < 1500) && now - entry.start < 10_000).length;
    };

    /** Fills {{runTag}}, {{runTagLower}}, {{date±n}}, {{isoDate±n}} and remembered values; `as` code or regex escapes them. */
    const text = (value, as = 'text') => {
        const escape = as === 'code' ? codeText : as === 'regex' ? regexText : (inner) => inner;
        return String(value).replace(/\{\{([A-Za-z][A-Za-z0-9]*)(?:([+-])(\d{1,3}))?\}\}/g, (match, name, sign, amount) => {
            const shift = amount === undefined ? 0 : Number(amount) * (sign === '-' ? -1 : 1);
            if (name === 'runTag') return escape(runTag);
            if (name === 'runTagLower') return escape(runTag.toLowerCase());
            if (name === 'date') return escape(localDate(day(shift)));
            if (name === 'isoDate') return escape(isoOf(day(shift)));
            if (remembered.has(name)) return escape(remembered.get(name));
            return match;
        });
    };
    const regex = (source, flags = '') => new RegExp(text(source, 'regex'), flags);

    /** Quiet page: nothing loading for 250 ms in a row; with `for` and `minCount` at least that many hits. Throws after the time. */
    const waitReady = async ({ for: store = null, minCount = null, soft = false, timeout = CAW.readyTimeoutMs ?? READY.timeout } = {}) => {
        const started = Date.now();
        let quietSince = null;
        for (;;) {
            const sample = await page.evaluate(PROBE, store).catch(() => null);
            const busy = sample === null ? 1 : sample.pendingAjax + (CAW.countNetwork ? pending() : 0);
            const quiet = sample !== null && busy === 0 && sample.loadingStores === 0 && (minCount === null || (sample.counts ?? 0) >= minCount);
            const now = Date.now();
            if (quiet) {
                quietSince ??= now;
                if (now - quietSince >= READY.quietMs) return;
            } else {
                quietSince = null;
            }
            if (now - started >= timeout) {
                if (soft) return;
                throw new Error(`The page did not become quiet within ${timeout} ms${store === null ? '' : ` (${store}: ${sample?.counts ?? 0} of ${minCount ?? 1})`}.`);
            }
            await page.waitForTimeout(READY.pollMs);
