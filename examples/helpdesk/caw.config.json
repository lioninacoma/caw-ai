{
    "language": "en",
    "framework": "web",
    "environments": {
        "local": {
            "url": "http://localhost:4173",
            "claude": true,
            "writable": true
        }
    },
    "auth": {
        "type": "form",
        "path": "/login",
        "userSelector": "#user",
        "passwordSelector": "#password",
        "submitSelector": "[data-testid=\"login\"]",
        "signedInSelector": "[data-testid=\"user-menu\"]"
    },
    "apps": {
        "web": {
            "dir": ".",
            "startUrl": "/"
        }
    },
    "roles": {
        "user": {
            "loginEnv": "CAW_LOGIN_USER",
            "passwordEnv": "CAW_PW_USER"
        }
    }
}
