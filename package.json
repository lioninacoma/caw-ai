{
    "name": "caw-ai",
    "version": "1.0.0-rc.2",
    "description": "caw-ai, Context-Aware Web Testing: target-driven development for web apps. The plain-language test plan is the spec; caw checks it without AI until the app meets it, then keeps it as a regression test.",
    "keywords": [
        "testing",
        "e2e",
        "regression-testing",
        "web-testing",
        "test-driven-development",
        "visual-regression",
        "bug-reproduction",
        "playwright",
        "chrome",
        "claude-code",
        "mcp",
        "ai",
        "context-aware"
    ],
    "author": "Frederick Schubert",
    "homepage": "https://github.com/lioninacoma/caw-ai#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lioninacoma/caw-ai.git"
    },
    "bugs": {
        "url": "https://github.com/lioninacoma/caw-ai/issues"
    },
    "license": "MIT",
    "type": "module",
    "bin": {
        "caw": "bin/caw.mjs"
    },
    "files": [
        "assets/",
        "bin/",
        "src/",
        "templates/",
        "README.md",
        "NOTICE.md",
        "README.de.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22.4"
    },
    "scripts": {
        "lint": "eslint .",
        "test": "node --import ./test/setup-de.mjs --test \"test/*.test.mjs\"",
        "e2e": "node e2e/native-e2e.mjs",
        "pack:check": "node scripts/pack-check.mjs",
        "prepack": "node scripts/pack-check.mjs"
    },
    "dependencies": {
        "playwright-core": "1.64.1",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "eslint-plugin-n": "^18.5.0",
        "globals": "^17.14.0"
    }
}
